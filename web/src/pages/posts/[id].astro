---
import { getCollection, render } from 'astro:content';
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";

export async function getStaticPaths() {
    const posts = await getCollection("posts")
    return posts.map(
        (post) => (
            {
                params: { id: post.id },
                props: { post },
            }
        )
    );
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={ post.data.title }>
    <article class="prose prose-a:text-blue-700 prose-headings:font-semibold prose-code:before:content-none prose-code:after:content-none [&_:not(pre)>code]:bg-gray-100 [&_:not(pre)>code]:px-1 [&_:not(pre)>code]:rounded">
        <h1>{ post.data.title }</h1>
        <p>
            Published date: <FormattedDate date={ post.data.pubDate }></FormattedDate>
        </p>
        {
            post.data.tags.length > 0 && (
                <div class="not-prose flex flex-wrap gap-2">
                    <span>
                        Tags:
                    </span>
                    <ul class="flex flex-wrap gap-2">
                        {
                            post.data.tags.map((tag) =>
                                <li>
                                    <a class="rounded bg-gray-200 px-2 text-sm hover:bg-gray-400" href=`/tags/${tag}/`>#{tag}</a>
                                </li>
                            )
                        }
                    </ul>
                </div>
            )
        }
        <Content />
    </article>
</BaseLayout>
