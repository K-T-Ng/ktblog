---
import { getCollection, render } from 'astro:content';
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";

export async function getStaticPaths() {
    const posts = await getCollection("posts")
    return posts.map(
        (post) => (
            {
                params: { id: post.id },
                props: { post },
            }
        )
    );
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={ post.data.title }>
    <article class="prose prose-a:text-blue-700 prose-headings:font-semibold prose-code:before:content-none prose-code:after:content-none [&_:not(pre)>code]:bg-gray-100 [&_:not(pre)>code]:px-1 [&_:not(pre)>code]:rounded">
        <h1>{ post.data.title }</h1>
        <p>
            Published date: <FormattedDate date={ post.data.pubDate }></FormattedDate>
        </p>
        <Content />
    </article>
</BaseLayout>
