---
import BaseLayout from "../layouts/BaseLayout.astro";

const description = "The page you're looking for doesn't exist or has been moved.";
---

<BaseLayout title="Page not found" description={ description } ogType="website">
    <h1 class="text-3xl my-5 font-bold">Page not found</h1>
    <p>{ description }</p>
    <p>
        <a class="underline hover:text-blue-800 dark:hover:text-blue-200" href="/">Back to the homepage</a>
    </p>
</BaseLayout>
