---
import {type CollectionEntry, getCollection} from "astro:content";
import { sortByPubDateDesc } from "../../utils/posts.ts";
import { SITE_NAME } from "../../utils/site.ts";
import PostList from "../../components/PostList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("posts");
    const sortedPosts = sortByPubDateDesc(posts);

    const tagPostsMap: Map<string, CollectionEntry<"posts">[]> = new Map();
    for (const post of sortedPosts) {
        for (const tag of post.data.tags) {
            let tagPosts = tagPostsMap.get(tag);
            if (tagPosts === undefined) {
                tagPosts = [];
                tagPostsMap.set(tag, tagPosts);
            }
            tagPosts.push(post);
        }
    }

    return Array.from(tagPostsMap, ([tag, posts]) => (
        {
            params: { tag },
            props: { tag, posts },
        }
    ))
}

const { tag, posts } = Astro.props;
---

<BaseLayout title=`Posts tagged "${ tag }"` description=`Posts tagged ${tag} on ${ SITE_NAME }, newest first.` ogType="website">
    <h1 class="text-3xl my-5 font-bold">Posts tagged "{ tag }"</h1>
    <PostList posts={ posts } />
</BaseLayout>
