---
import "../styles/global.css";
import { SITE_NAME } from "../utils/site.ts";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
    title: string;
    description: string;
    ogType: "website" | "article";
}

const { title, description, ogType } = Astro.props;
const formattedTitle = (title === SITE_NAME) ? SITE_NAME : `${title} | ${SITE_NAME}`;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en" class="scheme-light dark:scheme-dark">
    <head>
        <meta charset="utf-8" />
        <script is:inline>
            {
                let theme;
                try {
                    theme = localStorage.getItem("theme");
                } catch {}  // Follow system configuration when local storage is blocked.

                let isDarkMode;
                switch (theme) {
                    case "dark":
                        isDarkMode = true;
                        break;
                    case "light":
                        isDarkMode = false;
                        break;
                    default:
                        isDarkMode = window.matchMedia("(prefers-color-scheme: dark)").matches;
                        break;
                }
                document.documentElement.classList.toggle("dark", isDarkMode);
            }
        </script>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="alternate" type="application/rss+xml" title={ SITE_NAME } href={ new URL("rss.xml", Astro.site) } />
        <link rel="canonical" href={ canonicalUrl } />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={ Astro.generator } />
        <meta name="description" content={ description } />
        <meta property="og:title" content={ title } />
        <meta property="og:description" content={ description } />
        <meta property="og:url" content={ canonicalUrl } />
        <meta property="og:type" content={ ogType } />
        <meta property="og:site_name" content={ SITE_NAME } />
        <meta name="twitter:card" content="summary" />
        <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
        <script type="module" src="/pagefind/pagefind-component-ui.js"></script>
        <title>{ formattedTitle }</title>
    </head>
    <body class="leading-relaxed bg-white text-gray-900 dark:bg-gray-900 dark:text-white">
        <pagefind-modal />
        <header class="border-b font-bold">
            <div class="mx-auto max-w-prose px-6 flex items-center justify-between">
                <a href="/">{ SITE_NAME }</a>
                <div class="flex gap-3 items-center">
                    <pagefind-modal-trigger /> <ThemeToggle />
                </div>
            </div>
        </header>
        <main class="mx-auto my-3 max-w-prose px-6">
            <slot />
        </main>
        <footer class="mx-auto max-w-prose px-6 text-sm text-gray-600 dark:text-gray-400">
            <p>&copy; { new Date().getFullYear() } K-T-Ng</p>
        </footer>
    </body>
</html>
