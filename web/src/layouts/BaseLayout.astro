---
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props {
    title: string;
}
const { title } = Astro.props;
---

<html lang="en" class="scheme-light dark:scheme-dark">
    <head>
        <meta charset="utf-8" />
        <script is:inline>
            {
                let theme;
                try {
                    theme = localStorage.getItem("theme");
                } catch {}  // Follow system configuration when local storage is blocked.

                let isDarkMode;
                switch (theme) {
                    case "dark":
                        isDarkMode = true;
                        break;
                    case "light":
                        isDarkMode = false;
                        break;
                    default:
                        isDarkMode = window.matchMedia("(prefers-color-scheme: dark)").matches;
                        break;
                }
                document.documentElement.classList.toggle("dark", isDarkMode);
            }
        </script>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="alternate" type="application/rss+xml" title="KT's Blog" href={ new URL("rss.xml", Astro.site) } />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{ title }</title>
    </head>
    <body class="leading-relaxed bg-white text-gray-900 dark:bg-gray-900 dark:text-white">
        <header class="border-b font-bold">
            <div class="mx-auto max-w-prose px-6 flex items-center justify-between">
                <a href="/">KT's Blog</a>
                <ThemeToggle />
            </div>
        </header>
        <main class="mx-auto my-3 max-w-prose px-6">
            <slot />
        </main>
        <footer class="mx-auto max-w-prose px-6 text-sm text-gray-600 dark:text-gray-400">
            <p>&copy; { new Date().getFullYear() } K-T-Ng</p>
        </footer>
    </body>
</html>
